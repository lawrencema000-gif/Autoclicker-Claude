    <!-- Settings: anti-detection labels (plain language) -->
    <string name="anti_vary_location">Vary tap location</string>
    <string name="anti_vary_location_desc">Moves each tap by a few pixels — helps with apps that detect bots</string>
    <string name="anti_randomize_timing">Randomize tap timing</string>
    <string name="anti_randomize_timing_desc">Slightly changes the delay between taps so it looks human</string>
    <string name="anti_vary_hold">Vary hold time</string>
    <string name="anti_vary_hold_desc">Holds each tap for slightly different durations</string>
    <string name="anti_unique_pixel">Never tap the same pixel twice</string>
    <string name="anti_unique_pixel_desc">Avoids being flagged for suspiciously identical taps</string>
    <string name="anti_micro_pauses">Occasional tiny pauses</string>
    <string name="anti_micro_pauses_desc">Adds brief random pauses, like a real person getting distracted</string>
